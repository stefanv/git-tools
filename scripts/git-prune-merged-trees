#!/usr/bin/env bash
# Remove worktrees whose branches are merged into the default branch of origin
# (fast-forward, merge commit, rebase, or squash).  Branches are kept.
# Usage: git-prune-merged-trees [--force|-f]   (--force: do not prompt)

set -euo pipefail

FORCE=0
for arg in "$@"; do
  case "$arg" in
    --force|-f) FORCE=1 ;;
    *) echo "Unknown argument: $arg" >&2; exit 1 ;;
  esac
done

git rev-parse --git-dir >/dev/null
here="$(git rev-parse --show-toplevel 2>/dev/null || true)"

echo "Fetching origin..."
git fetch --quiet origin || echo "  fetch failed; using local refs" >&2
git worktree prune

base="$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null || echo origin/main)"
git rev-parse --verify --quiet "$base" >/dev/null || { echo "No base ref $base" >&2; exit 1; }
base_tree="$(git rev-parse "$base^{tree}")"
echo "Base: $base"

# Print how $1 reached $base; fail if it did not.
merged_how() {
  local b="$1" out mb squash
  if git merge-base --is-ancestor "$b" "$base"; then
    echo "ancestor of $base"; return
  fi
  # Merging the branch into base changes nothing.
  out="$(git merge-tree --write-tree "$base" "$b" 2>/dev/null || true)"
  if [[ "${out%%$'\n'*}" == "$base_tree" ]]; then
    echo "no changes against $base"; return
  fi
  # The combined branch diff has an equivalent patch in base (squash merge).
  mb="$(git merge-base "$base" "$b")"
  squash="$(git commit-tree "$b^{tree}" -p "$mb" -m squash)"
  out="$(git cherry "$base" "$squash")"
  if [[ "$out" == -* ]]; then
    echo "squash-merged"; return
  fi
  # Every commit has an equivalent patch in base (rebase merge).
  out="$(git cherry "$base" "$b")"
  if [[ "$out" != *"+"* ]]; then
    echo "rebase-merged"; return
  fi
  return 1
}

# One "path<TAB>branch-ref" line per linked worktree; the main worktree is excluded.
mapfile -t entries < <(git worktree list --porcelain | awk '
  /^worktree / { path = substr($0, 10); branch = ""; n++ }
  /^branch /   { branch = substr($0, 8) }
  /^$/         { if (n > 1) print path "\t" branch }
')

pruned=0
for entry in ${entries[@]+"${entries[@]}"}; do
  dir="${entry%%$'\t'*}"
  ref="${entry#*$'\t'}"
  name="${dir#"$PWD"/}"

  if [[ -z "$ref" ]]; then
    echo "  $name: detached HEAD, keeping"; continue
  fi
  branch="${ref#refs/heads/}"
  if [[ "$dir" == "$here" ]]; then
    echo "  $name ($branch): current worktree, keeping"; continue
  fi
  if ! how="$(merged_how "$branch")"; then
    echo "  $name ($branch): not merged, keeping"; continue
  fi
  force_cmd="    to remove anyway: git worktree remove --force $(printf '%q' "$dir")"
  if [[ -n "$(git -C "$dir" status --porcelain)" ]]; then
    echo "  $name ($branch): $how, but has local changes, keeping"
    echo "$force_cmd"; continue
  fi

  if (( ! FORCE )); then
    read -r -p "  $name ($branch): $how -- remove? [y/N] " ans
    [[ "$ans" =~ ^[Yy]$ ]] || { echo "    skipped"; continue; }
  else
    echo "  $name ($branch): $how, removing"
  fi
  if git worktree remove "$dir"; then
    (( ++pruned ))
  else
    echo "$force_cmd"
  fi
done

echo ""
echo "$pruned worktree(s) removed."
